* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.app {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

.app-header {
  text-align: center;
  color: white;
  margin-bottom: 40px;
}

.app-header h1 {
  font-size: 2.5rem;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
}

.app-main {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 30px;
}

.pantry-section,
.recipes-section {
  background: white;
  border-radius: 12px;
  padding: 25px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.pantry-section h2,
.recipes-section h2 {
  color: #333;
  margin-bottom: 20px;
  font-size: 1.5rem;
}

.add-item {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.add-item input {
  flex: 1;
  padding: 12px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-size: 1rem;
  transition: border-color 0.3s;
}

.add-item input:focus {
  outline: none;
  border-color: #667eea;
}

.add-item button {
  padding: 12px 24px;
  background: #667eea;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.3s;
}

.add-item button:hover {
  background: #5568d3;
}

.pantry-list {
  list-style: none;
}

.pantry-list li {
  padding: 12px;
  margin-bottom: 8px;
  background: #f5f5f5;
  border-radius: 6px;
  border-left: 4px solid #667eea;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pantry-list li span {
  flex: 1;
}

.delete-btn {
  background: #ff4444;
  color: white;
  border: none;
  border-radius: 50%;
  width: 24px;
  height: 24px;
  cursor: pointer;
  font-size: 18px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s;
}

.delete-btn:hover {
  background: #cc0000;
}

.pantry-list .empty {
  text-align: center;
  color: #999;
  font-style: italic;
  background: transparent;
  border: none;
  padding: 20px;
}

.recipes-section .empty {
  text-align: center;
  color: #999;
  font-style: italic;
  padding: 20px;
}

.error-message {
  background: rgba(255, 68, 68, 0.2);
  color: white;
  padding: 10px 15px;
  border-radius: 6px;
  margin-top: 10px;
  font-size: 0.9rem;
}

.loading {
  text-align: center;
  color: #667eea;
  padding: 20px;
  font-style: italic;
}

.recipes-list {
  list-style: none;
}

.recipe-item {
  padding: 15px;
  margin-bottom: 15px;
  background: #f9f9f9;
  border-radius: 8px;
  border-left: 4px solid #764ba2;
}

.recipe-item h3 {
  color: #333;
  margin-bottom: 8px;
  font-size: 1.2rem;
}

.recipe-item p {
  color: #666;
  margin-bottom: 10px;
  line-height: 1.5;
}

.recipe-ingredients {
  color: #555;
  font-size: 0.9rem;
  margin-top: 8px;
}

.add-item button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.diagnostics-btn {
  margin-top: 10px;
  padding: 8px 16px;
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.9rem;
  transition: background 0.3s;
}

.diagnostics-btn:hover {
  background: rgba(255, 255, 255, 0.3);
}

.diagnostics-panel {
  background: white;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.diagnostics-panel h3 {
  color: #333;
  margin-bottom: 10px;
  font-size: 1.2rem;
}

.diagnostics-panel ul {
  list-style: none;
  margin: 15px 0;
}

.diagnostics-panel li {
  padding: 8px;
  margin-bottom: 5px;
  background: #f5f5f5;
  border-radius: 4px;
  font-family: monospace;
  font-size: 0.9rem;
}

.help-text {
  margin-top: 15px;
  padding: 10px;
  background: #e3f2fd;
  border-radius: 6px;
  color: #1976d2;
  font-size: 0.9rem;
}

/* Question Flow Styles */
.question-flow-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  padding: 0;
  overflow: hidden;
}

.question-flow-container {
  width: 100%;
  height: 100%;
  max-width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.question-card {
  background: white;
  border-radius: 0;
  padding: 60px 40px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  text-align: center;
  width: 100%;
  max-width: 800px;
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  animation: questionSlideIn 0.4s ease-out;
  position: relative;
}

@keyframes questionSlideIn {
  from {
    opacity: 0;
    transform: translateX(30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.question-title {
  color: #333;
  font-size: 2.2rem;
  margin-bottom: 50px;
  font-weight: 600;
  line-height: 1.3;
}

.question-form {
  display: flex;
  flex-direction: column;
  gap: 30px;
  flex: 1;
  justify-content: center;
  max-width: 600px;
  margin: 0 auto;
  width: 100%;
}

.question-input,
.question-textarea {
  width: 100%;
  padding: 20px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-size: 1.1rem;
  transition: border-color 0.3s;
  font-family: inherit;
}

.question-input:focus,
.question-textarea:focus {
  outline: none;
  border-color: #667eea;
}

.question-textarea {
  resize: vertical;
  min-height: 150px;
}

.question-options {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 16px;
  margin-bottom: 10px;
}

.question-option-btn {
  padding: 18px 24px;
  background: #f5f5f5;
  color: #333;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-size: 1.05rem;
  cursor: pointer;
  transition: all 0.3s;
  font-family: inherit;
  font-weight: 500;
}

.question-option-btn:hover {
  background: #e8e8e8;
  border-color: #667eea;
  transform: translateY(-2px);
}

.question-option-btn.selected {
  background: #667eea;
  color: white;
  border-color: #667eea;
}

.question-actions {
  display: flex;
  gap: 16px;
  justify-content: center;
  margin-top: 40px;
}

.skip-btn,
.next-btn {
  padding: 16px 40px;
  border: none;
  border-radius: 8px;
  font-size: 1.1rem;
  cursor: pointer;
  transition: all 0.3s;
  font-family: inherit;
  font-weight: 600;
  min-width: 120px;
}

.skip-btn {
  background: #f5f5f5;
  color: #666;
}

.skip-btn:hover {
  background: #e8e8e8;
  transform: translateY(-2px);
}

.next-btn {
  background: #667eea;
  color: white;
}

.next-btn:hover:not(:disabled) {
  background: #5568d3;
  transform: translateY(-2px);
}

.next-btn:disabled {
  background: #ccc;
  color: #999;
  cursor: not-allowed;
  opacity: 0.6;
}

.question-progress {
  margin-top: 50px;
  color: #999;
  font-size: 1rem;
  font-weight: 500;
}

.start-question-flow-btn {
  grid-column: 1 / -1;
  padding: 16px 32px;
  background: #667eea;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 1.1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
  margin-bottom: 20px;
  box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

.start-question-flow-btn:hover {
  background: #5568d3;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
}
